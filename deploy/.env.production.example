# Images are written by GitHub Actions to release.env. Do not add them here.

# PostgreSQL
POSTGRES_USER=kodpauza
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=kodpauza
DATABASE_URL=postgresql://kodpauza:replace-with-a-long-random-password@postgres:5432/kodpauza?schema=public

# Bind only to host nginx/caddy by default
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=4000
WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=3000

# Public legal operator details embedded into the web image during CI build.
# Configure matching GitHub Actions repository variables with these names.
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=replace-with-operator-name
NEXT_PUBLIC_LEGAL_OPERATOR_STATUS=replace-with-ip-or-company-status
NEXT_PUBLIC_LEGAL_OPERATOR_INN=replace-with-inn
# Optional for a self-employed operator without OGRNIP. Leave empty if not applicable.
NEXT_PUBLIC_LEGAL_OPERATOR_REGISTRATION_NUMBER=
NEXT_PUBLIC_LEGAL_OPERATOR_ADDRESS=
NEXT_PUBLIC_LEGAL_OPERATOR_EMAIL=

# API security
JWT_SECRET=replace-with-64-random-hex-characters
JWT_EXPIRES_IN=12h
PASSWORD_SALT_ROUNDS=12
IP_HASH_SECRET=replace-with-64-random-hex-characters
KODPAUZA_EMAIL_VERIFICATION_SECRET=replace-with-64-random-hex-characters
KODPAUZA_ALLOWED_ORIGINS=https://kodpauza.example
KODPAUZA_PUBLIC_DASHBOARD_URL=https://kodpauza.example
KODPAUZA_TRUST_PROXY=true
KODPAUZA_LOCAL_DEVELOPMENT=false
KODPAUZA_ALLOW_INSECURE_LOCALHOST=false
KODPAUZA_REQUIRE_EVENT_SIGNATURES=true
KODPAUZA_EXTENSION_SESSION_TTL_MS=15552000000

# Runtime policy signing key is an Ed25519 private PEM encoded as one base64 line.
# Never commit the real value. The matching public key is embedded in the extension.
KODPAUZA_RUNTIME_POLICY_VERSION=1
KODPAUZA_RUNTIME_POLICY_TTL_MS=900000
KODPAUZA_RUNTIME_POLICY_ENABLED=true
KODPAUZA_RUNTIME_POLICY_KEY_ID=kodpauza-runtime-2026-01
KODPAUZA_RUNTIME_POLICY_PRIVATE_KEY_BASE64=replace-with-base64-ed25519-private-pem
KODPAUZA_RUNTIME_POLICY_BLOCKED_TOOLS=
KODPAUZA_RUNTIME_POLICY_BLOCKED_TOOL_VERSIONS=
KODPAUZA_RUNTIME_POLICY_BLOCKED_SURFACES=
KODPAUZA_RUNTIME_POLICY_BLOCKED_CAMPAIGNS=

# Rate limits
KODPAUZA_RATE_LIMIT_WINDOW_MS=60000
KODPAUZA_RATE_LIMIT_AUTH=30
KODPAUZA_RATE_LIMIT_REGISTER=5
KODPAUZA_RATE_LIMIT_ADS=180
KODPAUZA_RATE_LIMIT_EVENTS=120
KODPAUZA_RATE_LIMIT_PAYMENTS=10
KODPAUZA_RATE_LIMIT_DEFAULT=600

# Cloudflare Turnstile server key
KODPAUZA_CAPTCHA_SECRET_KEY=replace-with-production-turnstile-secret
KODPAUZA_CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Email verification
KODPAUZA_DISPOSABLE_EMAIL_DOMAINS=
KODPAUZA_EMAIL_VERIFICATION_CODE_TTL_MS=900000
KODPAUZA_EMAIL_VERIFICATION_RESEND_COOLDOWN_MS=60000
KODPAUZA_EMAIL_VERIFICATION_MAX_ATTEMPTS=5
KODPAUZA_EMAIL_TRANSPORT=smtp
KODPAUZA_SMTP_HOST=smtp.example.com
KODPAUZA_SMTP_PORT=587
KODPAUZA_SMTP_SECURE=false
KODPAUZA_SMTP_REQUIRE_TLS=true
KODPAUZA_SMTP_CONNECTION_TIMEOUT_MS=8000
KODPAUZA_SMTP_GREETING_TIMEOUT_MS=8000
KODPAUZA_SMTP_SOCKET_TIMEOUT_MS=10000
KODPAUZA_SMTP_USER=replace-with-smtp-user
KODPAUZA_SMTP_PASSWORD=replace-with-smtp-password
KODPAUZA_SMTP_FROM=Kodpauza <noreply@kodpauza.example>

# Telegram alerts for unsupported Codex and Claude Code versions
KODPAUZA_TELEGRAM_BOT_TOKEN=
KODPAUZA_TELEGRAM_ADMIN_CHAT_ID=
KODPAUZA_TELEGRAM_NOTIFICATION_TIMEOUT_MS=8000
KODPAUZA_TELEGRAM_PROXY_HOST=
KODPAUZA_TELEGRAM_PROXY_USER=
KODPAUZA_TELEGRAM_PROXY_PASSWORD=

# Developer payouts
KODPAUZA_DEVELOPER_PAYOUT_MIN_KOPECKS=30000
KODPAUZA_DEVELOPER_PAYOUT_MAX_KOPECKS=100000000

# YooKassa. Keep both credentials empty if payments are not enabled yet.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
YOOKASSA_TIMEOUT_MS=12000
YOOKASSA_RECEIPT_VAT_CODE=
