# PostgreSQL
POSTGRES_PORT="55432"
POSTGRES_USER="kodpauza"
POSTGRES_PASSWORD="kodpauza"
POSTGRES_DB="kodpauza"
POSTGRES_SCHEMA="kodpauza_local"
DATABASE_URL="postgresql://kodpauza:kodpauza@localhost:55432/kodpauza?schema=kodpauza_local"
LOCAL_DATABASE_URL="postgresql://kodpauza:kodpauza@localhost:55432/kodpauza?schema=kodpauza_local"
TEST_DATABASE_URL="postgresql://kodpauza:kodpauza@localhost:55432/kodpauza?schema=kodpauza_test"

# Локальные порты и URL
API_HOST_PORT="4000"
WEB_HOST_PORT="3000"
API_PORT="4000"
WEB_PORT="3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
KODPAUZA_PUBLIC_DASHBOARD_URL="http://localhost:3000"
KODPAUZA_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Подтверждение сайта в поисковых системах; локально можно оставить пустым
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# Реквизиты оператора для юридических документов. Локально пустые значения показывают предупреждение.
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=""
NEXT_PUBLIC_LEGAL_OPERATOR_STATUS=""
NEXT_PUBLIC_LEGAL_OPERATOR_INN=""
NEXT_PUBLIC_LEGAL_OPERATOR_REGISTRATION_NUMBER=""
NEXT_PUBLIC_LEGAL_OPERATOR_ADDRESS=""
NEXT_PUBLIC_LEGAL_OPERATOR_EMAIL=""

# Режим разработки и безопасность
KODPAUZA_LOCAL_DEVELOPMENT="true"
NEXT_PUBLIC_LOCAL_DEVELOPMENT="true"
KODPAUZA_ALLOW_INSECURE_LOCALHOST="true"
JWT_SECRET="replace-with-a-long-local-secret"
JWT_EXPIRES_IN="12h"
PASSWORD_SALT_ROUNDS="10"
IP_HASH_SECRET="replace-with-a-local-hash-secret"
KODPAUZA_REQUIRE_EVENT_SIGNATURES="true"
KODPAUZA_EVENT_SIGNATURE_MAX_SKEW_MS="300000"
KODPAUZA_EXTENSION_SESSION_TTL_MS="15552000000"

# Signed runtime policy. An unsigned policy is accepted only from a localhost API in development.
KODPAUZA_RUNTIME_POLICY_VERSION="1"
KODPAUZA_RUNTIME_POLICY_TTL_MS="900000"
KODPAUZA_RUNTIME_POLICY_ENABLED="true"
KODPAUZA_RUNTIME_POLICY_KEY_ID="kodpauza-runtime-2026-01"
KODPAUZA_RUNTIME_POLICY_PRIVATE_KEY_BASE64=""
KODPAUZA_RUNTIME_POLICY_BLOCKED_TOOLS=""
KODPAUZA_RUNTIME_POLICY_BLOCKED_TOOL_VERSIONS=""
KODPAUZA_RUNTIME_POLICY_BLOCKED_SURFACES=""
KODPAUZA_RUNTIME_POLICY_BLOCKED_CAMPAIGNS=""

# Rate limit
KODPAUZA_RATE_LIMIT_WINDOW_MS="60000"
KODPAUZA_RATE_LIMIT_AUTH="30"
KODPAUZA_RATE_LIMIT_REGISTER="5"
KODPAUZA_RATE_LIMIT_ADS="180"
KODPAUZA_RATE_LIMIT_EVENTS="120"
KODPAUZA_RATE_LIMIT_PAYMENTS="10"
KODPAUZA_RATE_LIMIT_DEFAULT="600"

# CAPTCHA для локальной разработки
KODPAUZA_CAPTCHA_SECRET_KEY="1x0000000000000000000000000000000AA"
KODPAUZA_CAPTCHA_VERIFY_URL="https://challenges.cloudflare.com/turnstile/v0/siteverify"
KODPAUZA_CAPTCHA_DEV_TOKEN="kodpauza-local-captcha-pass"
NEXT_PUBLIC_CAPTCHA_DEV_TOKEN="kodpauza-local-captcha-pass"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# Подтверждение почты
KODPAUZA_DISPOSABLE_EMAIL_DOMAINS=""
KODPAUZA_EMAIL_VERIFICATION_SECRET="replace-with-a-long-email-verification-secret"
KODPAUZA_EMAIL_VERIFICATION_CODE_TTL_MS="900000"
KODPAUZA_EMAIL_VERIFICATION_RESEND_COOLDOWN_MS="60000"
KODPAUZA_EMAIL_VERIFICATION_MAX_ATTEMPTS="5"

# Почта; в local используется console, поэтому SMTP может быть пустым
KODPAUZA_EMAIL_TRANSPORT="console"
KODPAUZA_SMTP_HOST=""
KODPAUZA_SMTP_PORT="587"
KODPAUZA_SMTP_SECURE="false"
KODPAUZA_SMTP_REQUIRE_TLS="false"
KODPAUZA_SMTP_CONNECTION_TIMEOUT_MS="8000"
KODPAUZA_SMTP_GREETING_TIMEOUT_MS="8000"
KODPAUZA_SMTP_SOCKET_TIMEOUT_MS="10000"
KODPAUZA_SMTP_USER=""
KODPAUZA_SMTP_PASSWORD=""
KODPAUZA_SMTP_FROM="Kodpauza <noreply@localhost>"

# Telegram-уведомления о версиях Codex и Claude Code, требующих нового патча
KODPAUZA_TELEGRAM_BOT_TOKEN=""
KODPAUZA_TELEGRAM_ADMIN_CHAT_ID=""
KODPAUZA_TELEGRAM_NOTIFICATION_TIMEOUT_MS="8000"
KODPAUZA_TELEGRAM_PROXY_HOST=""
KODPAUZA_TELEGRAM_PROXY_USER=""
KODPAUZA_TELEGRAM_PROXY_PASSWORD=""

# Выплаты разработчикам
KODPAUZA_DEVELOPER_PAYOUT_MIN_KOPECKS="30000"
KODPAUZA_DEVELOPER_PAYOUT_MAX_KOPECKS="100000000"

# YooKassa; для local можно оставить реквизиты пустыми
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_API_BASE_URL="https://api.yookassa.ru/v3"
